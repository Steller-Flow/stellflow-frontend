# Copy to .env.local and adjust. Only one variable is read by the code
# today (app/lib/api/axiosClient.ts:3), and the module that reads it has no
# callers yet — see issue #46 — so the app runs without any env file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret here.

# Base URL of stellflow-backend, including its /api prefix.
# The backend listens on 3001 by default and mounts every route under /api.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- Stellar / Soroban (read-only contract calls, app/lib/soroban.ts) -------
# The escrow contract the app reads with get_admin / is_paused / get_version /
# get_escrow_ttl / get_escrow. Default is the SEP-0055 verified testnet
# deployment from Steller-Flow/stellflow-smartcontract.
NEXT_PUBLIC_ESCROW_CONTRACT_ID="CA77HTQMZAFBU5GVVFOEHT6AGCOVZJ2MXSEZ33DJJSZWY6NFFPPI67RS"
# "testnet" (default) or "public". Selects the network passphrase, the
# default RPC URL below, and the stellar.expert links.
NEXT_PUBLIC_STELLAR_NETWORK="testnet"
# Soroban RPC endpoint. Defaults to the SDF testnet RPC; the browser calls it
# directly, so it must allow CORS.
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
