# Copy to .env.local and adjust. Only one variable is read by the code
# today (app/lib/api/axiosClient.ts:3), and the module that reads it has no
# callers yet — see issue #46 — so the app runs without any env file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Never put a secret here.

# Base URL of stellflow-backend, including its /api prefix.
# The backend listens on 3001 by default and mounts every route under /api.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
